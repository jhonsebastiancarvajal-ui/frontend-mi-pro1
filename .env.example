# Archivo de ejemplo para las variables de entorno
# COPIA este archivo y renómbralo a ".env" (sin el .example) para usarlo en tu máquina.

# URL de la API del Backend
# -> Para desarrollo local: usa la URL donde corre tu backend local (ej. http://localhost:3000/api)
# -> Para producción: cambia esto por la URL del servidor donde desplegaste el backend (ej. https://api.miapp.com/api)
VITE_API_URL=http://localhost:3000/api
